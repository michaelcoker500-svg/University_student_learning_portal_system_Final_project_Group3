{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend - live GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend - offline preview",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Backend - database setup",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.setup_portal",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Backend - start team API",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.portal_service",
      "args": ["--host", "${input:backendIP}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "backendIP",
      "type": "promptString",
      "description": "IPv4 address of the backend PC on the team network (ipconfig)",
      "default": "127.0.0.1"
    }
  ]
}
